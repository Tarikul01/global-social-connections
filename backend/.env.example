# App — GSC (Global Social Connections) / FindNeighbour
# Local development / docker-compose.yml only.
# For Vercel see: backend/.env.vercel.example and root .env.vercel.example

APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
APP_SECRET=change-me-to-a-random-string-at-least-32-chars-long

# docker compose postgres → host port 5433
DATABASE_URL=postgresql://findneighbour:findneighbour@localhost:5433/findneighbour?sslmode=disable

# Maps: OpenStreetMap via Leaflet (no API key needed)

# Supabase Storage (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@findneighbour.app

# Security
SESSION_DURATION_HOURS=168
CSRF_SECRET=
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
