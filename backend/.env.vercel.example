# =============================================================================
# Vercel-only environment template (backend container)
# Copy → backend/.env.vercel  (gitignored) for docker-compose.vercel.yml
# Also paste the same keys into Vercel → Project → Settings → Environment Variables
# =============================================================================

APP_ENV=production

# Public URL of your Vercel deployment (same origin for SPA + API rewrites)
APP_URL=https://global-social-connections.vercel.app
FRONTEND_URL=https://global-social-connections.vercel.app

# Vercel injects PORT (default 80). Leave unset in the Vercel dashboard.
# For local docker-compose.vercel.yml we set PORT explicitly.
APP_PORT=80
PORT=80

# REQUIRED — external PostGIS (Vercel does not run Postgres)
# Example Supabase:
# DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://findneighbour:findneighbour@postgres:5432/findneighbour?sslmode=disable

# REQUIRED — at least 32 random characters
APP_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional — defaults to APP_SECRET
CSRF_SECRET=

SESSION_DURATION_HOURS=168
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# Optional — durable avatars (container disk is ephemeral on Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@findneighbour.app
