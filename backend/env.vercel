# Baked into the Vercel Docker image as /app/.env (see Dockerfile.vercel).
# Use Supabase POOLER host — direct db.*.supabase.co often fails DNS from cloud runtimes.

APP_ENV=production
# Do not bake PORT — Vercel injects the listen port at runtime.

APP_URL=https://global-social-connections.vercel.app
FRONTEND_URL=https://global-social-connections.vercel.app

APP_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
CSRF_SECRET=change-me-to-another-long-random-secret

# Pooler (works from Vercel). Password chars: ? → %3F  * → %2A  & → %26
DATABASE_URL=postgresql://postgres.mokyvinvlxndhuavphad:cvS7%3F4_Y9ac%2A%26LE@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

SUPABASE_URL=https://mokyvinvlxndhuavphad.supabase.co
SUPABASE_SERVICE_KEY=

SESSION_DURATION_HOURS=168
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

SMTP_FROM=noreply@findneighbour.app
