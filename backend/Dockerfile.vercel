# syntax=docker/dockerfile:1
# Vercel-only container — production env is baked from env.vercel (no dashboard .env needed).

FROM golang:1.25-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/server /app/server
COPY docker-entrypoint.vercel.sh /app/docker-entrypoint.vercel.sh
COPY env.vercel /app/.env
RUN chmod +x /app/docker-entrypoint.vercel.sh \
	&& mkdir -p /app/data/uploads

ENV APP_ENV=production
ENV APP_PORT=80
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/app/docker-entrypoint.vercel.sh"]
