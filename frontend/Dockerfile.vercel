# syntax=docker/dockerfile:1
# Vercel-only frontend container — static SPA on $PORT.
# /api is routed by vercel.json rewrites (or nginx.vercel.gateway.conf in compose.vercel).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV VITE_API_URL=
RUN npm run build

FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.vercel.conf /etc/nginx/templates/default.conf.template
COPY docker-entrypoint.vercel.sh /docker-entrypoint.vercel.sh
COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.vercel.sh
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.vercel.sh"]
